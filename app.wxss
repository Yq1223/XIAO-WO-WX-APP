/* 全局样式 */

/* Vant 图标字体覆盖 — 使用本地文件替代 CDN，解决 ERR_CACHE_MISS */
@font-face {
  font-family: 'vant-icon';
  font-weight: normal;
  font-style: normal;
  font-display: auto;
  src: url('/static/fonts/vant-icon.woff2') format('woff2'),
       url('/static/fonts/vant-icon.woff') format('woff');
}

page {
  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

/* 主题色变量 */
.theme-color { color: #FF6B35; }
.theme-bg { background-color: #FF6B35; }

/* 通用容器 */
.container {
  padding: 20rpx;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
