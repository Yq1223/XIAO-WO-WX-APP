/* 表白卡片样式 */
.confession-card {
  background-color: var(--card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-time {
  font-size: 22rpx;
  color: var(--text-hint);
}

.card-content {
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.6;
  margin-bottom: 16rpx;
  word-break: break-all;
}

.card-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.target-desc {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  background-color: rgba(255, 107, 53, 0.06);
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.target-text {
  font-size: 24rpx;
  color: var(--primary);
  margin-left: 8rpx;
}

.action-bar {
  display: flex;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.action-item {
  display: flex;
  align-items: center;
  margin-right: 48rpx;
}

.action-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-left: 8rpx;
}

.action-text.active {
  color: var(--primary);
}
