<!--
  表白卡片组件
  展示表白墙内容，支持匿名显示
-->
<view class="confession-card" bind:tap="onTap">
  <!-- 类型标签 + 时间 -->
  <view class="card-header">
    <van-tag
      type="{{confession.type === 1 ? 'danger' : confession.type === 2 ? 'primary' : 'warning'}}"
      size="medium"
    >
      {{confession.typeText}}
    </van-tag>
    <text class="card-time">{{confession.createTimeText}}</text>
  </view>

  <!-- 内容 -->
  <view class="card-content">
    <text>{{confession.content}}</text>
  </view>

  <!-- 图片 -->
  <view class="card-images" wx:if="{{confession.images && confession.images.length > 0}}">
    <van-image
      wx:for="{{confession.images}}"
      wx:key="index"
      wx:if="{{index < 3}}"
      width="180rpx"
      height="180rpx"
      fit="cover"
      radius="8rpx"
      src="{{item}}"
      catch:tap="onPreviewImage"
      data-index="{{index}}"
      use-loading-slot
    >
      <van-loading slot="loading" type="spinner" size="20" />
    </van-image>
  </view>

  <!-- 对象描述（表白/捞人场景） -->
  <view class="target-desc" wx:if="{{confession.targetDesc}}">
    <van-icon name="contact" color="#FF6B35" size="16" />
    <text class="target-text">{{confession.targetDesc}}</text>
  </view>

  <!-- 互动栏 -->
  <view class="action-bar">
    <view class="action-item" catch:tap="onLike">
      <van-icon name="{{confession.isLiked ? 'good-job' : 'good-job-o'}}" color="{{confession.isLiked ? '#FF6B35' : '#999'}}" size="18" />
      <text class="action-text {{confession.isLiked ? 'active' : ''}}">{{confession.likeCount || 0}}</text>
    </view>
    <view class="action-item">
      <van-icon name="chat-o" color="#999" size="18" />
      <text class="action-text">{{confession.commentCount || 0}}</text>
    </view>
    <view class="action-item" catch:tap="onCollect">
      <van-icon name="{{confession.isCollected ? 'star' : 'star-o'}}" color="{{confession.isCollected ? '#FAAD14' : '#999'}}" size="18" />
      <text class="action-text {{confession.isCollected ? 'active' : ''}}">{{confession.collectCount || 0}}</text>
    </view>
  </view>
</view>
