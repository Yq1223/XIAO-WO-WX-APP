/* 商品卡片样式 */
.market-card {
  background-color: var(--card);
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-image {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.sold-badge {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sold-badge text {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  transform: rotate(-15deg);
}

.card-info {
  padding: 16rpx;
}

.item-title {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
}

.original-price {
  font-size: 22rpx;
  color: var(--text-hint);
  text-decoration: line-through;
  margin-left: 8rpx;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.like-count {
  display: flex;
  align-items: center;
}

.like-text {
  font-size: 20rpx;
  color: var(--text-hint);
  margin-left: 4rpx;
}
