/* 帖子卡片样式 */
.post-card {
  background-color: var(--card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* 作者行 */
.author-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.author-info {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.author-school {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.post-time {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* 标题 */
.post-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  line-height: 1.4;
}

/* 内容 */
.post-content {
  margin-bottom: 16rpx;
}

.content-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 图片 */
.post-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.image-item {
  flex-shrink: 0;
}

/* 标签 */
.post-tag {
  margin-bottom: 16rpx;
}

/* 互动栏 */
.action-bar {
  display: flex;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.action-item {
  display: flex;
  align-items: center;
  margin-right: 48rpx;
}

.action-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-left: 8rpx;
}

.action-text.active {
  color: var(--primary);
}
