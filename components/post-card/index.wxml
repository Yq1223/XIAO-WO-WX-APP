<!--
  帖子卡片组件
  展示帖子摘要信息，点击跳转详情
-->
<view class="post-card" bind:tap="onTap">
  <!-- 作者信息 -->
  <view class="author-row">
    <user-avatar user="{{post.author}}" isAnonymous="{{post.isAnonymous}}" />
    <view class="author-info">
      <text class="author-name">{{post.isAnonymous ? '匿名用户' : post.author.nickname}}</text>
      <text class="author-school">{{post.author.school || ''}}</text>
    </view>
    <text class="post-time">{{post.createTimeText}}</text>
  </view>

  <!-- 标题 -->
  <view class="post-title" wx:if="{{post.title}}">
    <text>{{post.title}}</text>
  </view>

  <!-- 内容预览 -->
  <view class="post-content">
    <text class="content-text">{{post.content}}</text>
  </view>

  <!-- 图片（最多3张缩略图） -->
  <view class="post-images" wx:if="{{post.images && post.images.length > 0}}">
    <view
      class="image-item"
      wx:for="{{post.images}}"
      wx:key="index"
      wx:if="{{index < 3}}"
      catch:tap="onPreviewImage"
      data-index="{{index}}"
    >
      <van-image
        width="200rpx"
        height="200rpx"
        fit="cover"
        radius="8rpx"
        src="{{item}}"
        use-loading-slot
      >
        <van-loading slot="loading" type="spinner" size="20" />
      </van-image>
    </view>
  </view>

  <!-- 分类标签 -->
  <view class="post-tag" wx:if="{{post.categoryText}}">
    <van-tag plain color="#FF6B35" size="medium">{{post.categoryText}}</van-tag>
  </view>

  <!-- 互动数据栏 -->
  <view class="action-bar">
    <view class="action-item" catch:tap="onLike">
      <van-icon name="{{post.isLiked ? 'good-job' : 'good-job-o'}}" color="{{post.isLiked ? '#FF6B35' : '#999'}}" size="18" />
      <text class="action-text {{post.isLiked ? 'active' : ''}}">{{post.likeCount || 0}}</text>
    </view>
    <view class="action-item">
      <van-icon name="chat-o" color="#999" size="18" />
      <text class="action-text">{{post.commentCount || 0}}</text>
    </view>
    <view class="action-item" catch:tap="onCollect">
      <van-icon name="{{post.isCollected ? 'star' : 'star-o'}}" color="{{post.isCollected ? '#FAAD14' : '#999'}}" size="18" />
      <text class="action-text {{post.isCollected ? 'active' : ''}}">{{post.collectCount || 0}}</text>
    </view>
  </view>
</view>
