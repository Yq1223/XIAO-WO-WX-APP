/* 评论输入框样式 */
.comment-input-wrap {
  position: relative;
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 98;
}

.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #FFFFFF;
  border-top: 1rpx solid var(--border);
  z-index: 99;
}

.input-wrapper {
  flex: 1;
  height: 72rpx;
  background-color: var(--bg);
  border-radius: 36rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
}

.input-field {
  width: 100%;
  height: 100%;
  font-size: 28rpx;
  color: var(--text-primary);
}

.input-placeholder {
  color: var(--text-hint);
  font-size: 28rpx;
}

.send-btn {
  min-width: 120rpx !important;
}
