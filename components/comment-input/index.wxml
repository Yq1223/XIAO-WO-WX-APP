<!--
  底部评论输入框组件
  固定在页面底部，包含输入框和发送按钮
-->
<view class="comment-input-wrap">
  <!-- 遮罩层（聚焦时显示） -->
  <view class="mask" wx:if="{{focused}}" catch:tap="onBlur"></view>

  <view class="input-bar safe-bottom">
    <view class="input-wrapper">
      <input
        class="input-field"
        placeholder="{{placeholder || '说点什么...'}}"
        placeholder-class="input-placeholder"
        value="{{value}}"
        bindinput="onInput"
        bindfocus="onFocus"
        bindblur="onBlur"
        bindconfirm="onSend"
        confirm-type="send"
        focus="{{focus}}"
        adjust-position="{{true}}"
        cursor-spacing="16"
      />
    </view>
    <van-button
      type="primary"
      size="small"
      round
      disabled="{{!value}}"
      bind:click="onSend"
      custom-class="send-btn"
    >
      发送
    </van-button>
  </view>
</view>
