/* 首页样式 */
.search-bar {
  position: sticky;
  top: 0;
  z-index: 10;
}

.post-list {
  padding: 20rpx 24rpx;
  padding-bottom: 160rpx;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.no-more {
  padding: 20rpx 0;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.4);
  z-index: 100;
}
