<!--
  表白墙页面
-->
<van-toast id="van-toast" />

<view class="page">
  <!-- 子Tab -->
  <van-tabs
    active="{{activeType}}"
    bind:change="onTypeChange"
    color="#FF6B35"
    title-active-color="#FF6B35"
    sticky
    offset-top="0"
  >
    <van-tab
      wx:for="{{confessionTypes}}"
      wx:key="value"
      title="{{item.label}}"
      name="{{item.value}}"
    />
  </van-tabs>

  <!-- 列表 -->
  <view class="confession-list">
      <confession-card
        wx:for="{{confessionList}}"
        wx:key="id"
        confession="{{item}}"
        bind:like="onLike"
        bind:collect="onCollect"
      />

      <van-loading
        wx:if="{{loading}}"
        class="loading-more"
        type="spinner"
        color="#FF6B35"
        size="24"
      >
        加载中...
      </van-loading>

      <view class="no-more" wx:if="{{!hasMore && confessionList.length > 0}}">
        <van-divider contentPosition="center">没有更多了</van-divider>
      </view>

      <empty-state
        wx:if="{{!loading && confessionList.length === 0}}"
        text="还没有内容，快来发表第一条吧~"
        icon="default"
      />
  </view>

  <!-- 悬浮发表按钮 -->
  <view class="fab" bind:tap="onPublish">
    <van-icon name="edit" color="#FFF" size="24" />
  </view>
</view>
