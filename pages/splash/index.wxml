<!-- pages/splash/index.wxml -->
<view class="splash-container">
  <!-- 背景装饰 -->
  <view class="bg-circle circle-1"></view>
  <view class="bg-circle circle-2"></view>
  <view class="bg-circle circle-3"></view>

  <!-- 主内容区 -->
  <view class="splash-content">
    <!-- Logo -->
    <view class="logo-wrapper {{logoAnimation ? 'animate-logo' : ''}}">
      <image class="logo" src="/static/images/logo.png" mode="aspectFit"></image>
    </view>

    <!-- 应用名称 -->
    <view class="app-name {{nameAnimation ? 'animate-name' : ''}}">
      <text class="name-text">校窝</text>
    </view>

    <!-- 口号1 -->
    <view class="slogan slogan-1 {{slogan1Animation ? 'animate-slogan' : ''}}">
      <text class="slogan-text">小窝虽小，装得下整个校园</text>
    </view>

    <!-- 口号2 -->
    <view class="slogan slogan-2 {{slogan2Animation ? 'animate-slogan' : ''}}">
      <text class="slogan-text">校园大小事，一窝全知道</text>
    </view>

    <!-- 分割线装饰 -->
    <view class="divider {{dividerAnimation ? 'animate-divider' : ''}}"></view>

    <!-- 进入按钮 -->
    <view class="enter-btn {{btnAnimation ? 'animate-btn' : ''}}" bindtap="onEnter">
      <text class="enter-text">进入校窝</text>
      <van-icon name="arrow" color="#FF6B35" size="14px" />
    </view>
  </view>

  <!-- 底部版权 -->
  <view class="footer {{footerAnimation ? 'animate-footer' : ''}}">
    <text class="footer-text">有事，窝里说 🏠</text>
  </view>

  <!-- 跳过按钮 -->
  <view class="skip-btn" bindtap="onSkip" wx:if="{{showSkip}}">
    <text class="skip-text">跳过 {{countdown}}s</text>
  </view>
</view>
