/* pages/splash/index.wxss */

.splash-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: linear-gradient(160deg, #FF6B35 0%, #FF8C5A 40%, #FFB088 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* ===== 背景装饰圆 ===== */
.bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.1;
  background: #fff;
}

.circle-1 {
  width: 500rpx;
  height: 500rpx;
  top: -100rpx;
  right: -150rpx;
}

.circle-2 {
  width: 350rpx;
  height: 350rpx;
  bottom: 200rpx;
  left: -100rpx;
}

.circle-3 {
  width: 200rpx;
  height: 200rpx;
  top: 30%;
  right: 50rpx;
  opacity: 0.06;
}

/* ===== 主内容区 ===== */
.splash-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}

/* ===== Logo ===== */
.logo-wrapper {
  width: 180rpx;
  height: 180rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  opacity: 0;
  transform: scale(0.3);
}

.logo {
  width: 120rpx;
  height: 120rpx;
}

/* ===== 应用名 ===== */
.app-name {
  margin-top: 36rpx;
  opacity: 0;
  transform: translateY(30rpx);
}

.name-text {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 12rpx;
  text-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
}

/* ===== 口号 ===== */
.slogan {
  margin-top: 24rpx;
  opacity: 0;
  transform: translateY(40rpx);
}

.slogan-text {
  font-size: 30rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 4rpx;
}

.slogan-2 {
  margin-top: 16rpx;
}

/* ===== 分割线 ===== */
.divider {
  width: 80rpx;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 2rpx;
  margin-top: 50rpx;
  opacity: 0;
  transform: scaleX(0);
}

/* ===== 进入按钮 ===== */
.enter-btn {
  margin-top: 60rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 64rpx;
  background: #FFFFFF;
  border-radius: 50rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
  opacity: 0;
  transform: translateY(40rpx);
}

.enter-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FF6B35;
  letter-spacing: 4rpx;
}

/* ===== 底部版权 ===== */
.footer {
  position: absolute;
  bottom: 80rpx;
  opacity: 0;
  transform: translateY(20rpx);
}

.footer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 2rpx;
}

/* ===== 跳过按钮 ===== */
.skip-btn {
  position: absolute;
  top: 100rpx;
  right: 32rpx;
  padding: 12rpx 28rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 30rpx;
  z-index: 100;
}

.skip-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* ============================================================
   动画定义
   ============================================================ */

/* Logo 弹出动画 */
.animate-logo {
  animation: logoIn 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes logoIn {
  0% {
    opacity: 0;
    transform: scale(0.3);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* 应用名渐入 */
.animate-name {
  animation: fadeUp 0.6s ease-out 0.4s forwards;
}

/* 口号渐入 */
.animate-slogan {
  animation: fadeUp 0.6s ease-out forwards;
}

.slogan-1.animate-slogan {
  animation-delay: 0.8s;
}

.slogan-2.animate-slogan {
  animation-delay: 1.1s;
}

/* 分割线展开 */
.animate-divider {
  animation: expandLine 0.5s ease-out 1.4s forwards;
}

/* 按钮弹入 */
.animate-btn {
  animation: fadeUp 0.6s ease-out 1.6s forwards;
}

/* 底部渐入 */
.animate-footer {
  animation: fadeUp 0.5s ease-out 2.0s forwards;
}

@keyframes fadeUp {
  0% {
    opacity: 0;
    transform: translateY(40rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes expandLine {
  0% {
    opacity: 0;
    transform: scaleX(0);
  }
  100% {
    opacity: 1;
    transform: scaleX(1);
  }
}
