<!--
  搜索页面
-->
<view class="page">
  <!-- 搜索栏 -->
  <view class="search-header">
    <van-search
      value="{{keyword}}"
      placeholder="搜索..."
      shape="round"
      focus
      bind:search="onSearch"
      bind:change="onInputChange"
      bind:clear="onClear"
    />
  </view>

  <!-- 搜索Tab -->
  <van-tabs
    wx:if="{{hasSearched}}"
    active="{{activeTab}}"
    bind:change="onTabChange"
    color="#FF6B35"
    title-active-color="#FF6B35"
  >
    <van-tab title="帖子" name="post" />
    <van-tab title="商品" name="market" />
  </van-tabs>

  <!-- 搜索结果 -->
  <block wx:if="{{hasSearched}}">
    <!-- 帖子结果 -->
    <view wx:if="{{activeTab === 'post'}}" class="result-list">
      <post-card wx:for="{{postResults}}" wx:key="id" post="{{item}}" />
      <van-loading wx:if="{{searchLoading}}" class="loading-more" type="spinner" color="#FF6B35" size="24" />
      <empty-state wx:if="{{!searchLoading && postResults.length === 0}}" text="没有找到相关帖子" />
    </view>

    <!-- 商品结果 -->
    <view wx:if="{{activeTab === 'market'}}" class="result-list waterfall">
      <view class="waterfall-column">
        <market-card wx:for="{{leftResults}}" wx:key="id" item="{{item}}" imageHeight="{{280}}" />
      </view>
      <view class="waterfall-column">
        <market-card wx:for="{{rightResults}}" wx:key="id" item="{{item}}" imageHeight="{{260}}" />
      </view>
      <van-loading wx:if="{{searchLoading}}" class="loading-more" type="spinner" color="#FF6B35" size="24" />
      <empty-state wx:if="{{!searchLoading && marketResults.length === 0}}" text="没有找到相关商品" />
    </view>
  </block>

  <!-- 搜索历史（未搜索时显示） -->
  <block wx:if="{{!hasSearched}}">
    <view class="history-section" wx:if="{{searchHistory.length > 0}}">
      <view class="section-header">
        <text class="section-title">搜索历史</text>
        <text class="clear-history" bind:tap="onClearHistory">清空</text>
      </view>
      <view class="history-tags">
        <view
          class="history-tag"
          wx:for="{{searchHistory}}"
          wx:key="index"
          bind:tap="onTapHistory"
          data-keyword="{{item}}"
        >
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 热门搜索 -->
    <view class="hot-section">
      <view class="section-header">
        <text class="section-title">热门搜索</text>
      </view>
      <view class="history-tags">
        <view class="hot-tag" wx:for="{{hotSearches}}" wx:key="index" bind:tap="onTapHistory" data-keyword="{{item}}">
          <van-icon name="fire-o" color="#FF6B35" size="14" wx:if="{{index < 3}}" />
          <text>{{item}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
