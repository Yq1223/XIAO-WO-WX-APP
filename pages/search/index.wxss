/* 搜索页样式 */
.search-header {
  position: sticky;
  top: 0;
  z-index: 10;
}

.result-list {
  padding: 20rpx 24rpx;
}

.waterfall {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}

.waterfall-column {
  flex: 1;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

/* 搜索历史 */
.history-section,
.hot-section {
  padding: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.clear-history {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-tag,
.hot-tag {
  padding: 12rpx 24rpx;
  background-color: var(--bg);
  border-radius: 24rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

.hot-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
