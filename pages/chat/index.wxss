/* 私聊页样式 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--bg);
}

.message-list {
  flex: 1;
  padding: 20rpx;
  padding-bottom: 20rpx;
}

.load-more {
  display: flex;
  justify-content: center;
  padding: 16rpx 0;
}

.message-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.message-item.self {
  flex-direction: row-reverse;
}

.msg-avatar {
  flex-shrink: 0;
  margin: 0 12rpx;
}

.msg-bubble {
  max-width: 60%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  position: relative;
  word-break: break-all;
}

.other-bubble {
  background-color: #FFFFFF;
  border-top-left-radius: 4rpx;
}

.self-bubble {
  background-color: #FF6B35;
  border-top-right-radius: 4rpx;
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.5;
}

.self-bubble .msg-text {
  color: #FFFFFF;
}

.other-bubble .msg-text {
  color: var(--text-primary);
}

/* 商品卡片消息 */
.item-card {
  display: flex;
  align-items: center;
  min-width: 360rpx;
}

.card-info {
  margin-left: 12rpx;
  flex: 1;
}

.card-title {
  font-size: 24rpx;
  color: var(--text-primary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-price {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
  margin-top: 4rpx;
  display: block;
}

/* 底部输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #FFFFFF;
  border-top: 1rpx solid var(--border);
}

.input-wrapper {
  flex: 1;
  height: 72rpx;
  background-color: var(--bg);
  border-radius: 36rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
}

.msg-input {
  width: 100%;
  height: 100%;
  font-size: 28rpx;
}

.input-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.send-btn {
  min-width: 100rpx !important;
  background-color: var(--primary) !important;
  border-color: var(--primary) !important;
}
