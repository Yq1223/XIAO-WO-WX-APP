/* 他人主页样式 */
.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx 32rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C5A 100%);
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-top: 16rpx;
}

.profile-school {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.profile-bio {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
  text-align: center;
}

.profile-stats {
  display: flex;
  gap: 80rpx;
  margin-top: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.follow-btn {
  margin-top: 24rpx;
  min-width: 200rpx;
  background-color: #FFFFFF !important;
  border-color: #FFFFFF !important;
  color: #FF6B35 !important;
}

.list-section {
  padding: 20rpx 24rpx;
}

.waterfall {
  display: flex;
  gap: 16rpx;
}

.waterfall-column {
  flex: 1;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}
