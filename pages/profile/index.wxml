<!--
  他人主页
-->
<view class="page">
  <!-- 用户信息 -->
  <view class="profile-header">
    <van-image round width="128rpx" height="128rpx" src="{{userInfo.avatar || '/static/images/default-avatar.png'}}" />
    <text class="profile-name">{{userInfo.nickname || '用户'}}</text>
    <text class="profile-school" wx:if="{{userInfo.school}}">{{userInfo.school}}</text>
    <text class="profile-bio" wx:if="{{userInfo.bio}}">{{userInfo.bio}}</text>

    <view class="profile-stats">
      <view class="stat-item">
        <text class="stat-num">{{userInfo.postCount || 0}}</text>
        <text class="stat-label">发布</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{userInfo.fanCount || 0}}</text>
        <text class="stat-label">粉丝</text>
      </view>
    </view>

    <van-button
      type="primary"
      round
      size="small"
      custom-class="follow-btn"
      bind:click="onFollow"
    >
      {{isFollowed ? '已关注' : '关注'}}
    </van-button>
  </view>

  <!-- 发布列表 -->
  <van-tabs
    active="{{activeTab}}"
    bind:change="onTabChange"
    color="#FF6B35"
    title-active-color="#FF6B35"
  >
    <van-tab title="帖子" name="post" />
    <van-tab title="闲置" name="item" />
  </van-tabs>

  <view class="list-section">
    <post-card wx:if="{{activeTab === 'post'}}" wx:for="{{postList}}" wx:key="id" post="{{item}}" />

    <view wx:if="{{activeTab === 'item'}}" class="waterfall">
      <view class="waterfall-column">
        <market-card wx:for="{{leftList}}" wx:key="id" item="{{item}}" imageHeight="{{280}}" />
      </view>
      <view class="waterfall-column">
        <market-card wx:for="{{rightList}}" wx:key="id" item="{{item}}" imageHeight="{{260}}" />
      </view>
    </view>

    <van-loading wx:if="{{loading}}" class="loading-more" type="spinner" color="#FF6B35" size="24" />
    <empty-state wx:if="{{!loading && ((activeTab === 'post' && postList.length === 0) || (activeTab === 'item' && itemList.length === 0))}}" text="暂无内容" />
  </view>
</view>
