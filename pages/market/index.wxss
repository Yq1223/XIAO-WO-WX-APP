/* 跳蚤市场样式 */
.search-bar {
  position: sticky;
  top: 0;
  z-index: 10;
}

.filter-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid var(--border);
}

.filter-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 8rpx 0;
}

.filter-item.active {
  color: var(--primary);
  font-weight: 600;
}

/* 瀑布流 */
.waterfall {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: 160rpx;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.no-more {
  padding: 20rpx 0;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.4);
  z-index: 100;
}
