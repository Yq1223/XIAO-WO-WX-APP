/* 发布闲置样式 */
.form-section {
  background-color: #FFFFFF;
  margin-bottom: 20rpx;
  padding: 24rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background-color: var(--bg);
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid transparent;
}

.category-item.active {
  background-color: rgba(255, 107, 53, 0.1);
  color: var(--primary);
  border-color: var(--primary);
}

.price-inputs {
  display: flex;
  gap: 24rpx;
}

.price-item {
  flex: 1;
}

.price-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
  display: block;
}

.price-input {
  height: 80rpx;
  background-color: var(--bg);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary);
}

.submit-area {
  padding: 40rpx 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.submit-btn {
  background-color: var(--primary) !important;
  border-color: var(--primary) !important;
}
