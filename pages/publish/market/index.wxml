<!--
  发布闲置商品页面
-->
<van-toast id="van-toast" />

<view class="page">
  <!-- 标题 -->
  <view class="form-section">
    <van-field
      value="{{title}}"
      placeholder="商品标题"
      border="{{false}}"
      bind:input="onTitleInput"
      maxlength="50"
      show-word-limit
    />
  </view>

  <!-- 描述 -->
  <view class="form-section">
    <van-field
      value="{{description}}"
      placeholder="描述一下商品的情况、购买渠道等..."
      type="textarea"
      border="{{false}}"
      bind:input="onDescInput"
      maxlength="1000"
      show-word-limit
      autosize
    />
  </view>

  <!-- 图片上传 -->
  <view class="form-section">
    <view class="form-label">商品图片 (最多9张)</view>
    <image-upload
      fileList="{{imageList}}"
      maxCount="{{9}}"
      bind:change="onImageChange"
    />
  </view>

  <!-- 分类 -->
  <view class="form-section">
    <view class="form-label">商品分类</view>
    <view class="category-grid">
      <view
        class="category-item {{activeCategory === item.value ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="value"
        bind:tap="onSelectCategory"
        data-value="{{item.value}}"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 价格 -->
  <view class="form-section">
    <view class="price-inputs">
      <view class="price-item">
        <text class="price-label">售价</text>
        <input
          class="price-input"
          type="digit"
          placeholder="¥0.00"
          value="{{price}}"
          bindinput="onPriceInput"
        />
      </view>
      <view class="price-item">
        <text class="price-label">原价</text>
        <input
          class="price-input"
          type="digit"
          placeholder="¥0.00 (选填)"
          value="{{originalPrice}}"
          bindinput="onOriginalPriceInput"
        />
      </view>
    </view>
  </view>

  <!-- 成色 -->
  <view class="form-section">
    <view class="form-label">商品成色</view>
    <view class="category-grid">
      <view
        class="category-item {{activeCondition === item.value ? 'active' : ''}}"
        wx:for="{{conditions}}"
        wx:key="value"
        bind:tap="onSelectCondition"
        data-value="{{item.value}}"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 交易方式 -->
  <view class="form-section">
    <view class="form-label">交易方式</view>
    <view class="category-grid">
      <view
        class="category-item {{activeTrade === item.value ? 'active' : ''}}"
        wx:for="{{tradeMethods}}"
        wx:key="value"
        bind:tap="onSelectTrade"
        data-value="{{item.value}}"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 交易地点 -->
  <view class="form-section">
    <van-field
      value="{{location}}"
      placeholder="交易地点（选填）"
      border="{{false}}"
      bind:input="onLocationInput"
      maxlength="100"
    />
  </view>

  <!-- 匿名开关 -->
  <view class="form-section">
    <van-cell title="匿名发布" label="开启后他人将看不到你的信息">
      <van-switch
        slot="right-icon"
        checked="{{isAnonymous}}"
        bind:change="onAnonymousChange"
        size="24"
        active-color="#FF6B35"
      />
    </van-cell>
  </view>

  <!-- 发布按钮 -->
  <view class="submit-area">
    <van-button
      type="primary"
      round
      block
      size="large"
      disabled="{{!canSubmit}}"
      loading="{{submitting}}"
      bind:click="onSubmit"
      custom-class="submit-btn"
    >
      发布闲置
    </van-button>
  </view>
</view>
