<!--
  发布表白页面
-->
<van-toast id="van-toast" />

<view class="page">
  <!-- 类型选择 -->
  <view class="form-section">
    <view class="form-label">选择类型</view>
    <view class="type-grid">
      <view
        class="type-item {{activeType === item.value ? 'active' : ''}}"
        wx:for="{{confessionTypes}}"
        wx:key="value"
        bind:tap="onSelectType"
        data-value="{{item.value}}"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 内容 -->
  <view class="form-section">
    <van-field
      value="{{content}}"
      placeholder="{{activeType === 1 ? '勇敢说出你的心里话...' : activeType === 2 ? '描述一下你想找的人...' : '把这里当树洞，尽情倾诉...'}}"
      type="textarea"
      border="{{false}}"
      bind:input="onContentInput"
      maxlength="1000"
      show-word-limit
      autosize
    />
  </view>

  <!-- 对象描述（表白/捞人时显示） -->
  <view class="form-section" wx:if="{{activeType !== 3}}">
    <van-field
      value="{{targetDesc}}"
      placeholder="描述一下TA的特征（选填）"
      border="{{false}}"
      bind:input="onTargetInput"
      maxlength="100"
    />
  </view>

  <!-- 图片上传 -->
  <view class="form-section">
    <view class="form-label">添加图片 (最多3张)</view>
    <image-upload
      fileList="{{imageList}}"
      maxCount="{{3}}"
      bind:change="onImageChange"
    />
  </view>

  <!-- 发布按钮 -->
  <view class="submit-area">
    <van-button
      type="primary"
      round
      block
      size="large"
      disabled="{{!canSubmit}}"
      loading="{{submitting}}"
      bind:click="onSubmit"
      custom-class="submit-btn"
    >
      发布
    </van-button>
  </view>
</view>
