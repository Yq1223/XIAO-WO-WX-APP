<!--
  发布帖子页面
-->
<van-toast id="van-toast" />

<view class="page">
  <!-- 分类选择 -->
  <view class="form-section">
    <view class="form-label">选择分类</view>
    <view class="category-grid">
      <view
        class="category-item {{activeCategory === item.value ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="value"
        bind:tap="onSelectCategory"
        data-value="{{item.value}}"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 标题 -->
  <view class="form-section">
    <van-field
      value="{{title}}"
      placeholder="给帖子起个标题吧~"
      border="{{false}}"
      bind:input="onTitleInput"
      maxlength="50"
      show-word-limit
    />
  </view>

  <!-- 内容 -->
  <view class="form-section">
    <van-field
      value="{{content}}"
      placeholder="分享你的故事..."
      type="textarea"
      border="{{false}}"
      bind:input="onContentInput"
      maxlength="2000"
      show-word-limit
      autosize
      custom-class="content-field"
    />
  </view>

  <!-- 图片上传 -->
  <view class="form-section">
    <view class="form-label">添加图片 (最多9张)</view>
    <image-upload
      fileList="{{imageList}}"
      maxCount="{{9}}"
      bind:change="onImageChange"
    />
  </view>

  <!-- 匿名开关 -->
  <view class="form-section">
    <van-cell title="匿名发布" label="开启后他人将看不到你的信息">
      <van-switch
        slot="right-icon"
        checked="{{isAnonymous}}"
        bind:change="onAnonymousChange"
        size="24"
        active-color="#FF6B35"
      />
    </van-cell>
  </view>

  <!-- 发布按钮 -->
  <view class="submit-area">
    <van-button
      type="primary"
      round
      block
      size="large"
      disabled="{{!canSubmit}}"
      loading="{{submitting}}"
      bind:click="onSubmit"
      custom-class="submit-btn"
    >
      发布
    </van-button>
  </view>
</view>
