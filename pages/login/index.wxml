<!--
  登录页面
-->
<van-toast id="van-toast" />

<view class="login-page">
  <!-- Logo + Slogan -->
  <view class="logo-section">
    <image class="logo" src="/static/images/logo.png" mode="aspectFit" />
    <text class="app-name">校窝</text>
    <text class="slogan">有事，窝里说。</text>
  </view>

  <!-- 登录按钮 -->
  <view class="login-section">
    <van-button
      type="primary"
      round
      block
      size="large"
      loading="{{logging}}"
      bind:click="onWxLogin"
      custom-class="wx-login-btn"
      icon="wechat"
    >
      微信一键登录
    </van-button>
  </view>

  <!-- 隐私协议 -->
  <view class="agreement">
    <van-icon
      name="{{agreed ? 'passed' : 'circle'}}"
      color="{{agreed ? '#FF6B35' : '#CCC'}}"
      size="18"
      bind:tap="onToggleAgreement"
    />
    <text class="agreement-text">
      登录即表示同意
      <text class="link" bind:tap="onUserAgreement">《用户协议》</text>
      和
      <text class="link" bind:tap="onPrivacyPolicy">《隐私政策》</text>
    </text>
  </view>
</view>
