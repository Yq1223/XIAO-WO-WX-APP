/* 登录页样式 */
.login-page {
  min-height: 100vh;
  background-color: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 240rpx;
  margin-bottom: 120rpx;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--primary);
  margin-bottom: 12rpx;
}

.slogan {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.login-section {
  width: 100%;
  margin-bottom: 48rpx;
}

.wx-login-btn {
  background-color: #07C160 !important;
  border-color: #07C160 !important;
  height: 88rpx !important;
  font-size: 32rpx !important;
}

.agreement {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.agreement-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.link {
  color: var(--primary);
}
