<!--
  通知列表页面
-->
<van-toast id="van-toast" />

<view class="page">
  <van-tabs
    active="{{activeTab}}"
    bind:change="onTabChange"
    color="#FF6B35"
    title-active-color="#FF6B35"
    sticky
  >
    <van-tab title="全部" name="all" />
    <van-tab title="点赞" name="like" />
    <van-tab title="评论" name="comment" />
    <van-tab title="系统" name="system" />
  </van-tabs>

  <!-- 全部已读 -->
  <view class="action-bar" wx:if="{{notifications.length > 0}}">
    <text class="mark-all" bind:tap="onMarkAllRead">全部已读</text>
  </view>

  <view class="notif-list">
      <view
        wx:for="{{notifications}}"
        wx:key="id"
        class="notif-item {{item.isRead ? '' : 'unread'}}"
        bind:tap="onTapNotif"
        data-item="{{item}}"
      >
        <van-icon
          name="{{item.type === 'like' ? 'good-job-o' : item.type === 'comment' ? 'chat-o' : 'info-o'}}"
          color="{{item.isRead ? '#999' : '#FF6B35'}}"
          size="22"
        />
        <view class="notif-content">
          <text class="notif-text">{{item.content}}</text>
          <text class="notif-time">{{item.createTimeText}}</text>
        </view>
        <view class="unread-dot" wx:if="{{!item.isRead}}"></view>
      </view>

      <van-loading wx:if="{{loading}}" class="loading-more" type="spinner" color="#FF6B35" size="24" />

      <view class="no-more" wx:if="{{!hasMore && notifications.length > 0}}">
        <van-divider contentPosition="center">没有更多了</van-divider>
      </view>

      <empty-state wx:if="{{!loading && notifications.length === 0}}" text="暂无通知" icon="bell" />
  </view>
</view>
