/* 通知列表样式 */
.action-bar {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 24rpx;
  background-color: #FFFFFF;
}

.mark-all {
  font-size: 26rpx;
  color: var(--primary);
}

.notif-list {
  padding: 0 24rpx;
  padding-bottom: 20rpx;
}

.notif-item {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.notif-item.unread {
  background-color: rgba(255, 107, 53, 0.04);
}

.notif-content {
  flex: 1;
  margin: 0 16rpx;
}

.notif-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.4;
  display: block;
}

.notif-time {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 6rpx;
  display: block;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: var(--error);
  flex-shrink: 0;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.no-more {
  padding: 20rpx 0;
}
