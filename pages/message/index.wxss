/* 会话列表样式 */
.conversation-list {
  padding-bottom: 20rpx;
}

.conversation-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.conv-avatar {
  flex-shrink: 0;
  margin-right: 20rpx;
  position: relative;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  color: #fff;
  background: var(--error);
  border-radius: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.conv-info {
  flex: 1;
  min-width: 0;
}

.conv-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.conv-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.conv-time {
  font-size: 22rpx;
  color: var(--text-hint);
}

.conv-preview {
  font-size: 26rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.delete-btn {
  width: 160rpx;
  height: 100%;
  background-color: var(--error);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}
