<!--
  浏览记录页面
-->
<view class="page">
  <view class="list-content">
      <view
        wx:for="{{historyList}}"
        wx:key="id"
        class="history-item"
        bind:tap="onTapItem"
        data-type="{{item.targetType}}"
        data-id="{{item.targetId}}"
      >
        <van-image
          width="120rpx"
          height="120rpx"
          fit="cover"
          radius="8rpx"
          src="{{item.coverImage || '/static/images/default-avatar.png'}}"
        />
        <view class="history-info">
          <text class="history-title">{{item.title}}</text>
          <text class="history-time">{{item.viewTimeText}}</text>
        </view>
        <van-icon name="arrow" color="#CCC" size="16" />
      </view>

      <van-loading wx:if="{{loading}}" class="loading-more" type="spinner" color="#FF6B35" size="24" />

      <view class="no-more" wx:if="{{!hasMore && historyList.length > 0}}">
        <van-divider contentPosition="center">没有更多了</van-divider>
      </view>

      <empty-state wx:if="{{!loading && historyList.length === 0}}" text="暂无浏览记录" icon="clock" />
  </view>
</view>
