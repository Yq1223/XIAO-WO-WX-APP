<view class="page">
  <!-- 顶部用户信息区域 -->
  <view class="header">
    <view class="header-bg">
      <view class="bubble bubble-1"></view>
      <view class="bubble bubble-2"></view>
      <view class="bubble bubble-3"></view>
      <view class="bubble bubble-4"></view>
      <view class="bubble bubble-5"></view>
      <view class="bubble bubble-6"></view>
    </view>
    <view class="user-section">
      <!-- 已登录：显示头像，点击跳转资料页 -->
      <view class="avatar-wrap" wx:if="{{isLoggedIn}}" bindtap="onLogin">
        <image class="avatar" src="{{userInfo.avatarUrl || '/static/images/default-avatar.png'}}" mode="aspectFill" />
      </view>
      <!-- 未登录：微信头像选择按钮 -->
      <view wx:else class="avatar-wrap">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="avatar" src="/static/images/default-avatar.png" mode="aspectFill" />
        </button>
      </view>

      <view class="user-info">
        <text class="nickname" wx:if="{{isLoggedIn}}">{{userInfo.nickName || '微信用户'}}</text>
        <text class="nickname" wx:else>点击登录</text>
        <view class="school-tag" wx:if="{{userInfo.school}}">
          <van-icon name="location-o" size="12" color="#fff" />
          <text>{{userInfo.school}}</text>
        </view>
      </view>
      <view class="setting-btn" bindtap="goSetting">
        <van-icon name="setting-o" size="22" color="#fff" />
      </view>
    </view>

    <!-- 数据统计 -->
    <view class="stats-card">
      <view class="stat-item" bindtap="goPublish">
        <text class="stat-num">{{stats.publish || 0}}</text>
        <text class="stat-label">发布</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="goFavorite">
        <text class="stat-num">{{stats.favorite || 0}}</text>
        <text class="stat-label">收藏</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="goFollow">
        <text class="stat-num">{{stats.follow || 0}}</text>
        <text class="stat-label">关注</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="goFans">
        <text class="stat-num">{{stats.fans || 0}}</text>
        <text class="stat-label">粉丝</text>
      </view>
    </view>
  </view>

  <!-- 常用功能 -->
  <view class="section">
    <view class="section-title">常用功能</view>
    <view class="card-box">
      <van-grid column-num="3" border="{{false}}">
        <van-grid-item icon="chat-o" text="我的消息" url="" />
        <van-grid-item icon="eye-o" text="浏览记录" url="" />
        <van-grid-item icon="points" text="我的积分" url="" />
      </van-grid>
    </view>
  </view>

  <!-- 管理员菜单 -->
  <view class="section" wx:if="{{isAdmin}}">
    <view class="section-title">管理后台</view>
    <view class="card-box">
      <van-cell-group>
        <van-cell title="订单管理" icon="orders-o" is-link url="/pages/admin-order/admin-order" />
        <van-cell title="反馈管理" icon="comment-o" is-link url="/pages/admin-feedback/admin-feedback" />
        <van-cell title="内容审核" icon="shield-o" is-link url="/pages/admin-audit/admin-audit" />
        <van-cell title="用户管理" icon="friends-o" is-link url="/pages/admin-user/admin-user" />
        <van-cell title="数据统计" icon="chart-trending-o" is-link url="/pages/admin-stats/admin-stats" />
        <van-cell title="举报处理" icon="warning-o" is-link url="/pages/admin-report/admin-report" />
        <van-cell title="推送管理" icon="bell" is-link url="/pages/admin-push/admin-push" />
        <van-cell title="权限管理" icon="manager-o" is-link url="/pages/admin-permission/admin-permission" />
      </van-cell-group>
    </view>
  </view>

  <!-- 底部菜单 -->
  <view class="section">
    <view class="card-box">
      <van-cell-group>
        <van-cell title="帮助中心" icon="question-o" is-link />
        <van-cell title="清除缓存" icon="delete-o" is-link bind:click="onClearCache" />
        <van-cell title="意见反馈" icon="comment-o" is-link />
        <van-cell title="关于我们" icon="info-o" is-link />
      </van-cell-group>
    </view>
  </view>
</view>
