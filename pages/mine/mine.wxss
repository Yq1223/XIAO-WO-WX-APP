/* 我的页面样式 */
.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: 40rpx;
}

/* 用户信息卡片 */
.user-card {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  margin: 0 0 20rpx 0;
}

.avatar-wrap {
  flex-shrink: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  background-color: rgba(255, 255, 255, 0.3);
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.school {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 分组标题 */
.group-title {
  font-size: 24rpx;
  color: #999;
  padding: 20rpx 32rpx 8rpx;
}

/* 卡片组间距 */
.section {
  margin: 20rpx 0;
}
