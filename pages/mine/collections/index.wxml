<!--
  我的收藏页面
-->
<view class="page">
  <van-tabs
    active="{{activeTab}}"
    bind:change="onTabChange"
    color="#FF6B35"
    title-active-color="#FF6B35"
    sticky
  >
    <van-tab title="帖子" name="post" />
    <van-tab title="表白" name="confession" />
    <van-tab title="闲置" name="item" />
  </van-tabs>

  <view class="list-content">
      <post-card wx:if="{{activeTab === 'post'}}" wx:for="{{postList}}" wx:key="id" post="{{item}}" />
      <confession-card wx:if="{{activeTab === 'confession'}}" wx:for="{{confessionList}}" wx:key="id" confession="{{item}}" />
      <market-card wx:if="{{activeTab === 'item'}}" wx:for="{{itemList}}" wx:key="id" item="{{item}}" imageHeight="{{280}}" />

      <van-loading wx:if="{{loading}}" class="loading-more" type="spinner" color="#FF6B35" size="24" />
      <empty-state wx:if="{{!loading && listEmpty}}" text="暂无收藏" icon="star" />
  </view>
</view>
