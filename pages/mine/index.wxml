<!--
  个人中心页面
-->
<van-toast id="van-toast" />

<view class="page">
  <!-- 已登录状态 -->
  <block wx:if="{{isLoggedIn}}">
    <!-- 用户信息卡片 -->
    <view class="user-card">
      <view class="user-header">
        <van-image
          round
          width="128rpx"
          height="128rpx"
          src="{{userInfo.avatar || '/static/images/default-avatar.png'}}"
          fit="cover"
        />
        <view class="user-info">
          <text class="user-name">{{userInfo.nickname || '校窝用户'}}</text>
          <text class="user-school">{{userInfo.school || '未设置学校'}}</text>
          <text class="user-bio" wx:if="{{userInfo.bio}}">{{userInfo.bio}}</text>
        </view>
        <van-icon name="arrow" color="#FFF" size="20" bind:tap="onEditProfile" />
      </view>

      <!-- 统计数据 -->
      <view class="stats-row">
        <view class="stat-item" bind:tap="onGoPosts">
          <text class="stat-num">{{stats.postCount || 0}}</text>
          <text class="stat-label">发布</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item" bind:tap="onGoCollections">
          <text class="stat-num">{{stats.collectCount || 0}}</text>
          <text class="stat-label">收藏</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item" bind:tap="onGoFans">
          <text class="stat-num">{{stats.fanCount || 0}}</text>
          <text class="stat-label">粉丝</text>
        </view>
      </view>
    </view>

    <!-- 功能列表 -->
    <view class="menu-section">
      <van-cell-group>
        <van-cell
          title="我的发布"
          icon="records"
          is-link
          bind:click="onGoPosts"
        >
          <van-icon name="records" color="#FF6B35" slot="icon" size="22" style="margin-right: 12rpx;" />
        </van-cell>
        <van-cell
          title="我的收藏"
          icon="star-o"
          is-link
          bind:click="onGoCollections"
        >
          <van-icon name="star-o" color="#FAAD14" slot="icon" size="22" style="margin-right: 12rpx;" />
        </van-cell>
        <van-cell
          title="浏览记录"
          icon="clock-o"
          is-link
          bind:click="onGoHistory"
        >
          <van-icon name="clock-o" color="#2A9D8F" slot="icon" size="22" style="margin-right: 12rpx;" />
        </van-cell>
      </van-cell-group>
    </view>

    <view class="menu-section">
      <van-cell-group>
        <van-cell
          title="消息通知"
          is-link
          bind:click="onGoMessage"
        >
          <view class="icon-badge-wrap" slot="icon">
            <van-icon name="chat-o" color="#FF6B35" size="22" style="margin-right: 12rpx;" />
            <view class="cell-badge" wx:if="{{unreadMsgCount > 0}}">{{unreadMsgCount > 99 ? '99+' : unreadMsgCount}}</view>
          </view>
        </van-cell>
        <van-cell
          title="通知"
          is-link
          bind:click="onGoNotification"
        >
          <view class="icon-badge-wrap" slot="icon">
            <van-icon name="bell" color="#722ED1" size="22" style="margin-right: 12rpx;" />
            <view class="cell-badge" wx:if="{{unreadNotifCount > 0}}">{{unreadNotifCount > 99 ? '99+' : unreadNotifCount}}</view>
          </view>
        </van-cell>
        <van-cell
          title="设置"
          icon="setting-o"
          is-link
          bind:click="onGoSettings"
        >
          <van-icon name="setting-o" color="#999" slot="icon" size="22" style="margin-right: 12rpx;" />
        </van-cell>
      </van-cell-group>
    </view>
  </block>

  <!-- 未登录状态 -->
  <block wx:else>
    <view class="login-guide">
      <van-empty image="network" description="登录后体验更多功能">
        <van-button
          type="primary"
          round
          size="large"
          custom-class="login-btn"
          bind:click="onLogin"
        >
          立即登录
        </van-button>
      </van-empty>
    </view>
  </block>
</view>
