/* 表白详情页样式 */
.type-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background-color: #FFFFFF;
}

.confession-time {
  font-size: 24rpx;
  color: var(--text-hint);
}

.content-section {
  padding: 24rpx;
  background-color: #FFFFFF;
  margin-bottom: 20rpx;
}

.confession-content {
  font-size: 32rpx;
  color: var(--text-primary);
  line-height: 1.8;
  word-break: break-all;
  white-space: pre-wrap;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.target-desc {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background-color: rgba(255, 107, 53, 0.06);
  border-radius: 12rpx;
  margin-top: 20rpx;
}

.target-text {
  font-size: 26rpx;
  color: var(--primary);
  margin-left: 8rpx;
}

.interaction-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 24rpx;
  background-color: #FFFFFF;
}

.interact-item {
  display: flex;
  align-items: center;
}

.interact-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-left: 8rpx;
}

.interact-text.active {
  color: var(--primary);
}

.comment-section {
  background-color: #FFFFFF;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}
