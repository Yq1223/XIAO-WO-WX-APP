/* 商品详情页样式 */
.image-swiper {
  width: 100%;
  height: 600rpx;
}

.price-section {
  padding: 24rpx;
  background-color: #FFFFFF;
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.current-price {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
}

.original-price {
  font-size: 26rpx;
  color: var(--text-hint);
  text-decoration: line-through;
  margin-left: 16rpx;
}

.condition-row {
  display: flex;
  gap: 12rpx;
}

.desc-section {
  padding: 24rpx;
  background-color: #FFFFFF;
  margin-top: 20rpx;
}

.item-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
  margin-bottom: 16rpx;
  display: block;
}

.item-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.trade-section {
  margin-top: 20rpx;
}

.seller-section {
  padding: 24rpx;
  background-color: #FFFFFF;
  margin-top: 20rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  display: block;
}

.seller-info {
  display: flex;
  align-items: center;
}

.seller-meta {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.seller-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.seller-school {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.interaction-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 24rpx;
  background-color: #FFFFFF;
  margin-top: 20rpx;
  margin-bottom: 120rpx;
}

.interact-item {
  display: flex;
  align-items: center;
}

.interact-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-left: 8rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #FFFFFF;
  border-top: 1rpx solid var(--border);
  z-index: 100;
}

.bottom-left {
  margin-right: 24rpx;
}

.bottom-action {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bottom-action-text {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.bottom-right {
  flex: 1;
}

.contact-btn {
  background-color: var(--primary) !important;
  border-color: var(--primary) !important;
}
