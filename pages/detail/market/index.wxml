<!--
  商品详情页
-->
<van-toast id="van-toast" />

<view class="page">
  <van-skeleton wx:if="{{loading}}" title row="5" loading />

  <block wx:if="{{!loading && item.id}}">
    <!-- 图片轮播 -->
    <swiper
      class="image-swiper"
      indicator-dots
      indicator-color="rgba(255,255,255,0.5)"
      indicator-active-color="#FFFFFF"
      autoplay
      circular
    >
      <swiper-item
        wx:for="{{item.images}}"
        wx:key="index"
        bind:tap="onPreviewImage"
        data-index="{{index}}"
      >
        <van-image width="100%" height="600rpx" fit="aspectFill" src="{{item}}" />
      </swiper-item>
    </swiper>

    <!-- 价格信息 -->
    <view class="price-section">
      <view class="price-row">
        <text class="current-price">¥{{item.price}}</text>
        <text class="original-price" wx:if="{{item.originalPrice}}">原价 ¥{{item.originalPrice}}</text>
      </view>
      <view class="condition-row">
        <van-tag plain color="#FF6B35" size="medium" wx:if="{{item.conditionText}}">
          {{item.conditionText}}
        </van-tag>
        <van-tag plain color="#2A9D8F" size="medium" wx:if="{{item.categoryText}}">
          {{item.categoryText}}
        </van-tag>
      </view>
    </view>

    <!-- 商品描述 -->
    <view class="desc-section">
      <text class="item-title">{{item.title}}</text>
      <text class="item-desc">{{item.description}}</text>
    </view>

    <!-- 交易信息 -->
    <view class="trade-section">
      <van-cell-group>
        <van-cell title="交易方式" value="{{item.tradeMethodText}}" />
        <van-cell title="交易地点" value="{{item.location || '面议'}}" wx:if="{{item.location}}" />
        <van-cell title="发布时间" value="{{item.createTimeText}}" />
      </van-cell-group>
    </view>

    <!-- 卖家信息 -->
    <view class="seller-section" bind:tap="onGoProfile">
      <text class="section-label">卖家信息</text>
      <view class="seller-info">
        <van-image
          round
          width="72rpx"
          height="72rpx"
          src="{{item.author.avatar || '/static/images/default-avatar.png'}}"
        />
        <view class="seller-meta">
          <text class="seller-name">{{item.author.nickname}}</text>
          <text class="seller-school">{{item.author.school || ''}}</text>
        </view>
        <van-icon name="arrow" color="#999" size="18" />
      </view>
    </view>

    <!-- 互动栏 -->
    <view class="interaction-bar">
      <view class="interact-item" bind:tap="onLike">
        <van-icon name="{{item.isLiked ? 'good-job' : 'good-job-o'}}" color="{{item.isLiked ? '#FF6B35' : '#999'}}" size="22" />
        <text class="interact-text">{{item.likeCount || 0}}</text>
      </view>
      <view class="interact-item" bind:tap="onCollect">
        <van-icon name="{{item.isCollected ? 'star' : 'star-o'}}" color="{{item.isCollected ? '#FAAD14' : '#999'}}" size="22" />
        <text class="interact-text">{{item.collectCount || 0}}</text>
      </view>
    </view>
  </block>

  <!-- 底部操作栏 -->
  <view class="bottom-bar safe-bottom" wx:if="{{!loading && item.id}}">
    <view class="bottom-left">
      <view class="bottom-action" bind:tap="onCollect">
        <van-icon name="{{item.isCollected ? 'star' : 'star-o'}}" color="{{item.isCollected ? '#FAAD14' : '#999'}}" size="24" />
        <text class="bottom-action-text">收藏</text>
      </view>
    </view>
    <view class="bottom-right">
      <van-button
        type="primary"
        round
        block
        custom-class="contact-btn"
        bind:click="onContact"
      >
        联系卖家
      </van-button>
    </view>
  </view>
</view>
